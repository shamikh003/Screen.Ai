# Copy this file to `.env` and fill in your own keys.
# Get a free Groq key at https://console.groq.com  (required)
GROQ_API_KEY=your_groq_key_here

# Optional — enables YouTube learning-video suggestions.
# Get one at https://console.cloud.google.com (YouTube Data API v3)
YOUTUBE_API_KEY=your_youtube_key_here
